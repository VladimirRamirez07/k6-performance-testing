# Copiar este archivo a .env y completar los valores
# cp .env.example .env

# API key de reqres.in — gratis en: https://reqres.in/signup
REQRES_API_KEY=your_api_key_here

# URL base de la API
BASE_URL=https://reqres.in/api

# Entorno (staging | production | ci)
ENVIRONMENT=staging

# Tiempo de pausa entre requests en segundos
SLEEP_DURATION=1